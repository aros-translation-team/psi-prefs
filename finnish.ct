;
MSG_HELP_INFO
Tietoja tilasta\nja koosta.
; Information about\nmode & size.
;
MSG_HELP_NAME
Julkisen näytön nimi.\nJokerimerkit sallittuja\nvieraille näytöille.
; Name of Public Screen.\nWildcards allowed for\nforeign screens.
;
MSG_HELP_TITLE
Teksti, joka näkyy\nnäytön otsikkopalkissa.
; Text that appears in\nthe screen's title bar.
;
MSG_HELP_FONT
Näytön\noletuskirjasin.
; Default font\nfor the screen.
;
MSG_HELP_BACKGROUND
Datatype-kuva, jota käytetään\ntaustakuviona.
; Datatype picture used\nas background pattern.
;
MSG_HELP_AUTOSCROLL
Näyttö vierii, kun hiiri\nosuu sen reunoihin.
; The screen scrolls when\nthe mouse hits its borders.
;
MSG_HELP_NODRAG
Näyttöä ei\nvoi vetää.
; The screen\nis undraggable.
;
MSG_HELP_EXCLUSIVE
Näyttö ei voi jakaa\nnäyttötilaansa muiden kanssa.
; The screen cannot share\nits display with others.
;
MSG_HELP_INTERLEAVED
Näytön bittikartta varataan\nlomitetussa tilassa.
; The screen's bitmap is allocated\nin interleaved mode.
;
MSG_HELP_BEHIND
Näyttö avautuu kaikkien\nmuiden näyttöjen taakse.
; The screen opens behind\nall other screens.
;
MSG_HELP_SYSTEMDEFAULT
Näytöstä tulee järjestelmän\noletusnäyttö.
; The screen becomes the\nsystem's default screen.
;
MSG_HELP_AUTOCLOSE
Näyttö sulkeutuu, kun\nviimeinen ikkuna suljetaan.
; The screen closes when\nthe last window is closed.
;
MSG_HELP_CLOSEGADGET
Näyttö saa\nsulkemispainikkeen.
; The screen gets\na close gadget.
;
MSG_HELP_MODELIST
Luettelo käytettävissä\nolevista näyttötiloista.
; List of available\ndisplay modes.
;
MSG_HELP_MODEINFO
Tietoja nykyisestä\nnäyttötilasta.
; Information about the\ncurrent display mode.
;
MSG_HELP_OVERSCAN
Overscan-koon säätö.
; Overscan size adjustment.
;
MSG_HELP_WIDTH
Näytön leveys\npikseleinä.
; Width of screen,\nmeasured in pixels.
;
MSG_HELP_HEIGHT
Näytön korkeus\npikseleinä.
; Height of screen,\nmeasured in pixels.
;
MSG_HELP_DEPTH
Näytön syvyys\nbittitasoina.
; Depth of screen,\nmeasured in planes.
;
MSG_HELP_PENLIST
Järjestelmäkynät, jotka voi\nvetää toiseen väriryhmään.
; System pens, draggable\nto different color pot.
;
MSG_HELP_COLORFIELD
Nykyinen väri, muuta sitä\nnapsauttamalla kenttää.
; Current color, click\non field to change it.
;
MSG_HELP_KILLCOLOR
Poista tämä väri\nryhmästä.
; Remove this color\nfrom the group.
;
MSG_HELP_NEWCOLOR
Lisää uusi väri\nryhmään.
; Add a new color\nto the group.
;
MSG_HELP_EDITOK
Poistu ja muista\ntämän näytön muutokset.
; Exit and remember\nchanges for this screen.
;
MSG_HELP_EDITCANCEL
Poistu ja \33bhylkää\33n\ntämän näytön muutokset.
; Exit and \33bdiscard\33n\nchanges for this screen.
;
MSG_HELP_SCREENLIST
Luettelo määritellyistä\njulkisista näytöistä.
; List of defined\npublic screens.
;
MSG_HELP_NEWSCREEN
Luo uusi\njulkinen näyttö.
; Create a new\npublic screen.
;
MSG_HELP_COPYSCREEN
Luo kopio\nnykyisestä näytöstä.
; Create a copy\nof current screen.
;
MSG_HELP_DELETESCREEN
Poista nykyinen\njulkinen näyttö.
; Delete current\npublic screen.
;
MSG_HELP_EDITSCREEN
Muokkaa nykyistä\njulkista näyttöä.
; Edit current\npublic screen.
;
MSG_HELP_OPENSCREEN
Avaa nykyinen\njulkinen näyttö.
; Open current\npublic screen.
;
MSG_HELP_CLOSESCREEN
Sulje nykyinen\njulkinen näyttö.
; Close current\npublic screen.
;
MSG_HELP_JUMPSCREEN
Hyppää nykyiseen\njulkiseen näyttöön.
; Jump to current\npublic screen.
;
MSG_HELP_SAVE
Poistu ja tallenna\nmuutokset levylle.
; Exit and save\nchanges to disk.
;
MSG_HELP_USE
Poistu ja tallenna muutokset\nnykyistä istuntoa varten.
; Exit and save changes\nfor current session.
;
MSG_HELP_CANCEL
Poistu ja\n\33bhylkää\33n muutokset.
; Exit and\n\33bdiscard\33n changes.
